{
  "name": "atelier-obsidian-panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An Obsidian workspace and experimental installed-runtime integration for Claude Desktop.",
  "repository": { "type": "git", "url": "https://github.com/Nielk74/claude-desktop-obsidian.git" },
  "homepage": "https://github.com/Nielk74/claude-desktop-obsidian#readme",
  "bugs": { "url": "https://github.com/Nielk74/claude-desktop-obsidian/issues" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "build:mod": "node scripts/build-mod.mjs",
    "build:desktop": "node scripts/build-desktop-ui.mjs",
    "install:desktop": "node scripts/install-desktop-ui.mjs",
    "restore:desktop": "node scripts/install-desktop-ui.mjs --restore",
    "preview:desktop": "node scripts/preview-desktop-ui.mjs",
